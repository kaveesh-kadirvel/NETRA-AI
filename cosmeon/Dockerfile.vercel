FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app
COPY requirements.txt /tmp/cosmeon-requirements.txt
RUN pip install --no-cache-dir -r /tmp/cosmeon-requirements.txt
COPY . /app/cosmeon

EXPOSE 80
CMD ["sh", "-c", "streamlit run cosmeon/app.py --server.address=0.0.0.0 --server.port=${PORT:-80} --server.headless=true"]